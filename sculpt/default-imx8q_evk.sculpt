drivers: imx8q_evk

# supplemental depot content added to the system image
import: pkg/sculpt_drivers-imx8q_evk

# selection of launcher-menu entries
launcher: black_hole

presets: empty screensaver

depot: genodelabs cnuke alex-ab nfeske cproc chelmuth jschlatow ssumpf skalk

build: app/sculpt_manager

manager: use_ram_fs

ram_fs: depot
